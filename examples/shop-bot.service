[Unit]
Description=shop-bot Telegram shop bot
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=shop-bot
Group=shop-bot
WorkingDirectory=/opt/shop-bot
StateDirectory=shop-bot
UMask=0077
Environment=SHOP_BOT_DATABASE_PATH=/var/lib/shop-bot/shop_bot.db

# 方式一：直接读项目根目录的 config.yaml
ExecStart=/opt/shop-bot/.venv/bin/shop-bot

# 方式二：指定其他路径的配置文件
# Environment=SHOP_BOT_CONFIG=/etc/shop-bot/config.yaml
# ExecStart=/opt/shop-bot/.venv/bin/shop-bot

# 也可以完全用环境变量覆盖（不依赖 config.yaml）
# Environment=SHOP_BOT_BOT_TOKEN=123456:ABC...
# Environment=SHOP_BOT_ADMIN_IDS=[123456789]
# Environment=SHOP_BOT_WEBHOOK__URL=https://bot.example.com
# Environment=SHOP_BOT_WEBHOOK__SECRET_TOKEN=REPLACE_WITH_RANDOM_SECRET

Restart=always
RestartSec=5
TimeoutStopSec=150

# 日志：stdout/stderr 走 journald，用 journalctl -u shop-bot -f 看
StandardOutput=journal
StandardError=journal
SyslogIdentifier=shop-bot

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/shop-bot

[Install]
WantedBy=multi-user.target
